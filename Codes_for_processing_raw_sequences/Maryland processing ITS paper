#Create script to generate manifest file that is needed to convert sequences to Qiime redable format

# Write script to create manifest file:
nano manifest.py 

#Write script

  import os

  # Directory where your fastq.gz files are located
  directory = "[Insert pathway to working directory]/trimmed/"

  # Output file
  output_file = "manifest.txt"

  # Open output file for writing
  with open(output_file, 'w') as f:
      # Write header
      f.write("sample-id,absolute-filepath,direction\n")
      
      # Loop through files in directory
      for filename in os.listdir(directory):
          if filename.endswith("_R1_t.fastq.gz"):
              # Extract sample-id (before _R) and create absolute path
              sample_id = filename.split("_R")[0]
              abs_path = os.path.join(directory, filename)
              
              # Write forward read
              f.write(f"{sample_id},{abs_path},forward\n")
              
              # Create reverse filename
              reverse_filename = filename.replace("_R1_t.fastq.gz", "_R2_t.fastq.gz")
              reverse_abs_path = os.path.join(directory, reverse_filename)
              
              # Write reverse read
              f.write(f"{sample_id},{reverse_abs_path},reverse\n")

  print(f"Formatted file saved as {output_file}")


# Created manifest file by running script
python3 manifest.py

# Import manifest.txt into a qiime readable format 

qiime tools import \
  --type "SampleData[PairedEndSequencesWithQuality]" \
  --input-format PairedEndFastqManifestPhred33\
  --input-path manifest.txt \
  --output-path sequences.qza

#Denoise and merge with DADA2

 qiime dada2 denoise-paired \
  --i-demultiplexed-seqs sequences.qza \
  --p-max-ee-f 8 \
  --p-max-ee-r 8 \
  --p-trunc-q 8 \
  --p-trunc-len-r 0 \
  --p-trunc-len-f 0 \
  --output-dir dadaout
  --verbose

#Check results
qiime metadata tabulate \
  --m-input-file dadaout/denoising_stats.qza  \
  --o-visualization denoising_stats.qzv
qiime tools view denoising_stats.qzv


#Remove short sequences
qiime rescript filter-seqs-length \
  --i-sequences dadaout/representative_sequences.qza \
  --p-global-min 100 \
  --o-filtered-seqs  rep-seqs-length-filtered.qza \
  --o-discarded-seqs discard_filtered.qza

qiime feature-table filter-features \
  --i-table dadaout/table.qza \
  --m-metadata-file rep-seqs-length-filtered.qza \
  --o-filtered-table table-length-filtered.qza

# Cluster the reads on 97%
qiime vsearch cluster-features-de-novo \
  --i-sequences rep-seqs-length-filtered.qza \
  --i-table table-length-filtered.qza \
  --p-perc-identity 0.97 \
  --o-clustered-table table-dada2-0_97_clust.qza \
  --o-clustered-sequences rep-seqs-dada2-0_97_clust.qza

qiime feature-table summarize \
  --i-table table-dada2-0_97_clust.qza \
  --o-visualization table_summary.qzv
  qiime tools view table_summary.qzv

qiime feature-classifier classify-consensus-blast \
  --p-evalue 0.000001 \
  --p-min-consensus 0.8 \
  --p-query-cov 0.97 \
  --i-query rep-seqs-dada2-0_97_clust.qza \
  --i-reference-reads [Insert pathway to classifier]/UNITE_public_19.02.2025.qza \
  --i-reference-taxonomy [Insert pathway to classifier]/UNITE_public_taxonomy_modi2_19.02.2025.qza \
  --p-perc-identity 0.97 \
  --output-dir TaxonomyFinal97Blast_fitler.qza \
  --verbose

#view table
qiime metadata tabulate \
