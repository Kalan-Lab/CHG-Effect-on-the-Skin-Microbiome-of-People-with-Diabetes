  fastp -q 25 --trim_poly_g --detect_adapter_for_pe -i ${i}.fastq.gz -I ${j}.fastq.gz -o [Insert pathway to working directory]/trimmed/${i}_t.fastq.gz -O [Insert pathway to working directory]/trimmed/${j}_t.fastq.gz
  done

  cd [Insert pathway to working directory]/trimmed/

  fastqc *.fastq.gz -o fastQC

  cd fastQC

  multiqc .

